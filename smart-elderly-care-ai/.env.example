# ==============================================================================
# SMART ELDERLY CARE AI - TEMPLATE CẤU HÌNH HỆ THỐNG (.ENV.EXAMPLE)
# ==============================================================================

# ---- 1. THÔNG TIN CHUNG & BẢO MẬT ----
APP_NAME="Smart Elderly Care AI"
DEBUG=True
SECRET_KEY=your_random_256bit_secret_key_here_for_development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- 2. DOCKER & CƠ SỞ DỮ LIỆU (TIMESCALEDB / POSTGRESQL) ----
POSTGRES_PASSWORD=postgres_secure_pass_123
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_123@localhost:5433/elderly_care

# ---- 3. REDIS CACHE & PUBSUB ----
REDIS_PASSWORD=redis_secure_pass_123
REDIS_URL=redis://:redis_secure_pass_123@localhost:6379/0

# ---- 4. EMQX MQTT BROKER ----
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=mqtt_secure_pass_123
MQTT_CLIENT_ID=backend-fastapi-001

# ---- 5. MINIO OBJECT STORAGE ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_123
MINIO_BUCKET_INCIDENTS=incidents
MINIO_SECURE=False

# ---- 6. THÔNG BÁO & DỊCH VỤ NGOÀI (FIREBASE / TWILIO) ----
FCM_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- 7. MOBILE APP (REACT NATIVE EXPO) ----
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---- 8. CHATBOT AI & RAG (GOOGLE GEMINI / OPENAI / DEEPSEEK) ----
# Lấy Gemini API Key miễn phí tại: https://aistudio.google.com/app/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
