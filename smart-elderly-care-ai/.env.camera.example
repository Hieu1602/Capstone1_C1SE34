TAPO_HOST=192.168.1.4
TAPO_USERNAME=your_camera_account
TAPO_PASSWORD='your_camera_password'
TAPO_STREAM=stream1
# UUID thiết bị camera trong database; dùng cho phân quyền mobile.
CAMERA_DEVICE_ID=
# Mã ngẫu nhiên ít nhất 16 ký tự để liên kết camera lần đầu trong mobile.
CAMERA_PAIRING_CODE=
CAMERA_SERVICE_URL=http://tapo-camera:8090
# HTTP Basic Auth cho trang xem và API; tách biệt Camera Account.
CAMERA_HTTP_USERNAME=viewer
CAMERA_HTTP_PASSWORD='replace-with-a-long-random-password'
# Để trống: dùng Camera Account. Nếu firmware yêu cầu cloud auth,
# dùng TAPO_CONTROL_USERNAME=admin và mật khẩu TP-Link ID bên dưới.
TAPO_CONTROL_USERNAME=
TAPO_CONTROL_PASSWORD=
TAPO_CLOUD_PASSWORD=
